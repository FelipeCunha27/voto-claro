{
  "auto-lint": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --fix . 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
